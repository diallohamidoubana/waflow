# ==============================================================================
# WAFLOW Local Development Environment Contract
# ==============================================================================
# Copy this file to .env for local runtime configuration.
# NEVER commit the actual .env file containing secrets or real credentials.

# Canonical PostgreSQL Connection URL
DATABASE_URL="postgresql://waflow:waflow_dev_password@127.0.0.1:5432/waflow_dev?schema=public"

# PostgreSQL Container Configuration (Docker Compose)
POSTGRES_DB="waflow_dev"
POSTGRES_USER="waflow"
POSTGRES_PASSWORD="waflow_dev_password"
POSTGRES_PORT="5432"
