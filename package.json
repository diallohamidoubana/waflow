{
  "name": "waflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf --glob .turbo **/dist",
    "db:format": "pnpm --filter @waflow/database db:format",
    "db:generate": "pnpm --filter @waflow/database db:generate",
    "db:migrate:deploy": "pnpm --filter @waflow/database db:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @waflow/database db:migrate:dev",
    "db:reset:local": "pnpm --filter @waflow/database db:reset:local",
    "db:studio": "pnpm --filter @waflow/database db:studio",
    "db:validate": "pnpm --filter @waflow/database db:validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.6"
  }
}
